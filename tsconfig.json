{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "esModuleInterop": true, "skipLibCheck": true, "declaration": true,
    "outDir": "dist", "rootDir": ".", "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist", "contracts", ".tmp"]
}
