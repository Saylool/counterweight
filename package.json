{
  "name": "counterweight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run && npm run web:test",
    "test:all": "npm test && cargo test --manifest-path contracts/policy/Cargo.toml --locked --lib",
    "build": "tsc -b && npm run web:build",
    "typecheck": "tsc --noEmit && npm --prefix apps/web run typecheck",
    "prove:signing": "tsx scripts/prove-signing.ts",
    "prove:submit": "tsx scripts/prove-submit.ts",
    "derive": "tsx scripts/derive.ts",
    "lifecycle": "tsx scripts/lifecycle.ts",
    "testnet:plan": "tsx scripts/testnet-plan.ts",
    "prove:contract:live": "tsx scripts/prove-contract-live.ts",
    "prove:contract": "tsx scripts/prove-contract.ts",
    "testnet:verify": "tsx scripts/testnet-verify.ts",
    "vectors:generate": ".tmp/sdk-venv/bin/python scripts/generate-signing-vectors.py",
    "economics": "node --require ./scripts/demo-offline-guard.cjs --import tsx scripts/economics.ts",
    "replay": "tsx apps/keeper/src/cli.ts",
    "capture:market": "tsx apps/keeper/src/capture-market.ts",
    "postinstall": "node scripts/install-local-sandbox.mjs",
    "demo:install": "node scripts/install-local-sandbox.mjs",
    "demo:local": "node --require ./scripts/demo-offline-guard.cjs --import tsx scripts/demo-local.ts",
    "demo:local:v3": "node --require ./scripts/demo-offline-guard.cjs --import tsx scripts/demo-local-v3.ts",
    "test:demo": "npm run demo:local",
    "keeper:dry": "tsx apps/keeper/src/dry.ts",
    "web": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:test": "npm --prefix apps/web test",
    "keeper:run": "tsx scripts/keeper-run.ts",
    "v2:cleanup": "tsx scripts/v2-cleanup.ts",
    "video": "tsx scripts/video/run.ts",
    "video:capture": "tsx scripts/video/capture.ts",
    "video:terminal": "tsx scripts/video/terminal.ts",
    "video:assemble": "tsx scripts/video/assemble.ts",
    "video:script": "tsx scripts/video/script.ts",
    "video:test": "vitest run scripts/video/video.test.ts",
    "video:remotion": "tsx scripts/video/remotion.ts",
    "video:remotion:test": "vitest run scripts/video/remotion.test.ts"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2",
    "@noble/curves": "^2.0.1",
    "@scure/base": "^2.0.0",
    "pino": "^10.0.0",
    "undici": "8.12.4",
    "viem": "^2.38.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@near-js/utils": "1.1.0",
    "@types/node": "^24.0.0",
    "near-workspaces": "5.0.0",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
